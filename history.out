   13  ls /tmp/*.rpm
   14  rpm -ivh /tmp/tcpdump-*.x86_64.rpm
   15  rpm -q tcpdump
   16  dnf history > ~/dnf.out; cat ~/dnf.out
   17  clear
   18  lsblk
   19  echo ',' | sfdisk -X gpt /dev/sdb
   20  mkfs.ext4 -L MEPHI_WEB /dev/sdb1
   21  mkdir /mephi-web
   22  clear
   23  echo 'LABEL=MEPHI_WEB /mephi-web ext4 defaults 0 2' >> /etc/fstab
   24  systemctl daemon-reload
