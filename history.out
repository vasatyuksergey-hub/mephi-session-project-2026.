   87  clear
   88  uptime; getenforce > ~/getenforce.out; cat ~/getenforce.out
   89  findmnt /mephi-web; systemctl is-enabled nginx; systemctl is-active nginx
   90  journalctl -u nginx -b > ~/journalctl.out; cat ~/journalctl.out
